{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "web-vue",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web-vue",
        "dev",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "react-compare",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "exec",
        "vite",
        "--config",
        "../../docs/vue-compare/react-harness/vite.config.ts"
      ],
      "port": 5181
    }
  ]
