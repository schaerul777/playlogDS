{
  "name": "web-vue",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,vue}\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@workspace/ui-vue": "workspace:*",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "vite": "^8",
    "vue-tsc": "^3.3.14"
  }
}
