{
  "name": "@workspace/ui-vue",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,vue}\"",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@workspace/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.46",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vue-tsc": "^3.3.14"
  },
  "exports": {
